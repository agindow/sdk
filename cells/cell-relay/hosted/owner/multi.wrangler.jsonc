{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agindow-keyless-multi-guard",
  "main": "worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "guard.agindow.com", "custom_domain": true }
  ],
  "vars": {
    "EXECUTION_ORIGIN": "https://guard.agindow.com",
    "KEYLESS_ENABLED": "true",
    "KEYLESS_POLICY_MODE": "auto",
    "KEYLESS_PROFILE": "legacy-disabled",
    "KEYLESS_MULTI_ORG": "true",
    "KEYLESS_HOST_POLICY": "{\"format\":2,\"version\":\"host-v1\",\"reviewerKid\":\"platform-v1\",\"origin\":\"https://guard.agindow.com\",\"profileKey\":\"customer\",\"environment\":\"test\",\"connection\":\"catalog-read\",\"tools\":[\"fetch\"],\"audience\":\"https://guard.agindow.com/v1/token\",\"until\":1795780461}",
    "GUARD_CONNECTIONS": ""
  },
  "secrets": {
    "required": [
      "KEYLESS_REVIEW_KEYS",
      "KEYLESS_DELIVERY_TOKEN",
      "KEYLESS_READINESS_TOKEN",
      "KEYLESS_READ_CATALOG"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTHORITY",
        "class_name": "KeylessExecutionOwner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "ti74-v1",
      "new_sqlite_classes": [
        "KeylessExecutionOwner"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    },
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ],
  "alias": {
    "@agindow/native-host": "../../crates/http-host/build/index.js"
  }
}
