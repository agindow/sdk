{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "agindow-keyless-operator",
  "main": "worker.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": { "required": ["OPERATOR_TOKEN"] },
  "services": [
    {
      "binding": "ADMIN",
      "service": "agindow-keyless-policy",
      "entrypoint": "Administration"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
