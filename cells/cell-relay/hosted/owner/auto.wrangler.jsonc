{
 "$schema":"../../node_modules/wrangler/config-schema.json",
 "name":"agindow-keyless-guard",
 "main":"worker.ts",
 "compatibility_date":"2026-10-27",
 "compatibility_flags":["nodejs_compat"],
 "workers_dev":false,
 "preview_urls":false,
 "vars":{"EXECUTION_ORIGIN":"https://guard.agindow.com","KEYLESS_ENABLED":"false","KEYLESS_POLICY_MODE":"auto","KEYLESS_PROFILE":"primary"},

 "secrets":{"required":["GUARD_CONNECTIONS","KEYLESS_REVIEW_KEYS","KEYLESS_DELIVERY_TOKEN","KEYLESS_READINESS_TOKEN"]},
 "durable_objects":{"bindings":[{"name":"AUTHORITY","class_name":"KeylessExecutionOwner"}]},
 "migrations":[{"tag":"ti74-v1","new_sqlite_classes":["KeylessExecutionOwner"]}],
 "observability":{"enabled":true,"traces":{"enabled":true},"logs":{"enabled":true,"invocation_logs":false}},
 "rules":[{"type":"CompiledWasm","globs":["**/*.wasm"],"fallthrough":true}],
 "alias":{"@agindow/native-host":"../../crates/http-host/build/index.js"}
}
