{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agindow.com/contracts/dashboard_query.v2.json",
  "title": "DashboardQuery",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resource": {
      "enum": [
        "connections",
        "drift",
        "audit",
        "reviews",
        "contracts",
        "investigations"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "to": {
      "type": "string",
      "format": "date-time"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "side": {
          "enum": [
            "request",
            "response",
            "both"
          ]
        },
        "class": {
          "enum": [
            "shape",
            "semantic",
            "unknown"
          ]
        },
        "detector": {
          "enum": [
            "shape",
            "statistical",
            "invariant",
            "cross_endpoint"
          ]
        },
        "mode": {
          "enum": [
            "observe",
            "repair",
            "strict"
          ]
        },
        "outcome": {
          "enum": [
            "ok",
            "degraded",
            "repaired",
            "blocked",
            "bypassed"
          ]
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "connection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "search": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[-a-zA-Z0-9_:.]+$"
        }
      }
    }
  },
  "required": [
    "resource",
    "limit",
    "from",
    "to",
    "filters"
  ]
}
