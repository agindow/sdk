{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialEvent",
  "description": "TI-65 bounded credential evidence; references are host-assigned identifiers, never secrets. Contract 10.53.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "id",
    "ts",
    "tenant",
    "connection",
    "operation",
    "cause",
    "evidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "connection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "credential_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "prior_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "prior_event": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "audit_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contract": {
      "enum": [
        "credential_event"
      ]
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "ts": {
      "type": "string",
      "minLength": 20,
      "maxLength": 30,
      "format": "date-time",
      "pattern": "Z$"
    },
    "cause": {
      "enum": [
        "rejected",
        "expired",
        "revoked",
        "scope_reduced",
        "quota",
        "rotated",
        "recovered",
        "unknown"
      ]
    },
    "evidence": {
      "enum": [
        "provider_declared",
        "host_declared",
        "inferred",
        "unknown"
      ]
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "failure_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "window_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cause": {
            "enum": [
              "expired",
              "revoked"
            ]
          }
        },
        "required": [
          "cause"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "enum": [
              "provider_declared",
              "host_declared"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cause": {
            "enum": [
              "scope_reduced"
            ]
          }
        },
        "required": [
          "cause"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "const": "inferred"
          },
          "failure_count": {},
          "window_ms": {}
        },
        "required": [
          "failure_count",
          "window_ms"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "failure_count"
              ],
              "properties": {
                "failure_count": {}
              }
            },
            {
              "required": [
                "window_ms"
              ],
              "properties": {
                "window_ms": {}
              }
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "cause": {
            "enum": [
              "rotated"
            ]
          }
        },
        "required": [
          "cause"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "const": "host_declared"
          },
          "prior_version": {},
          "credential_version": {}
        },
        "required": [
          "prior_version",
          "credential_version"
        ]
      },
      "else": {
        "not": {
          "required": [
            "prior_version"
          ],
          "properties": {
            "prior_version": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cause": {
            "enum": [
              "recovered"
            ]
          }
        },
        "required": [
          "cause"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "enum": [
              "provider_declared",
              "host_declared",
              "inferred"
            ]
          },
          "prior_event": {}
        },
        "required": [
          "prior_event"
        ]
      },
      "else": {
        "not": {
          "required": [
            "prior_event"
          ],
          "properties": {
            "prior_event": {}
          }
        }
      }
    }
  ]
}
