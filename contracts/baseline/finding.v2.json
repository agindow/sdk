{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding",
  "description": "The result of an asynchronous investigation by cell-cortex: vendor-published context for a drift, or the recorded absence of it. Consumed by cell-registry (agindow-runtime-contract.md \u00a74.1, \u00a75).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "id",
    "ts",
    "tool",
    "classification",
    "conclusion",
    "citations",
    "tenant",
    "investigation_id",
    "revision",
    "expires_at",
    "operation",
    "field",
    "contract_version",
    "fingerprint",
    "evidence_kind",
    "visibility",
    "hypothesis",
    "confidence",
    "uncertainty",
    "recommended_action",
    "vendor"
  ],
  "properties": {
    "contract": {
      "enum": [
        "finding"
      ]
    },
    "version": {
      "type": "integer",
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "vendor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "classification": {
      "enum": [
        "shape",
        "semantic",
        "unknown"
      ],
      "description": "What the investigation concluded the drift is. May differ from the engine's first reading."
    },
    "conclusion": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable verdict in one paragraph. 'No changelog found' is recorded here, with an empty citations array.",
      "maxLength": 4096
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      },
      "maxItems": 16
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "drift_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "investigation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "field": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contract_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_kind": {
      "enum": [
        "observation",
        "vendor",
        "hypothesis",
        "community",
        "customer",
        "peer",
        "missing"
      ]
    },
    "visibility": {
      "enum": [
        "private",
        "public"
      ]
    },
    "hypothesis": {
      "type": "boolean"
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "recommended_action": {
      "enum": [
        "review_vendor_migration",
        "review_contract",
        "contact_vendor",
        "request_scoped_repair_review"
      ]
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "quote",
        "retrieved_at"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
