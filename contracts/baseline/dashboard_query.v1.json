{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agindow.com/contracts/dashboard_query.v1.json",
  "title": "DashboardQuery",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resource": {
      "enum": [
        "connections",
        "drift",
        "audit",
        "reviews",
        "contracts",
        "investigations"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "to": {
      "type": "string",
      "format": "date-time"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },
  "required": [
    "resource",
    "limit",
    "from",
    "to",
    "filters"
  ]
}
