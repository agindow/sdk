{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agindow.com/contracts/dashboard_error.v1.json",
  "title": "DashboardError",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "unauthenticated",
            "forbidden",
            "not_found",
            "invalid_cursor",
            "invalid_query",
            "retention_expired",
            "unavailable",
            "method_not_allowed"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ]
    }
  },
  "required": [
    "error"
  ]
}
