{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShadowReview",
  "description": "TII-11 real observe-mode evidence and actor-attributed review intent. Never authorizes execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "case",
    "resolution"
  ],
  "properties": {
    "contract": {
      "enum": [
        "shadow_review"
      ]
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "created_at",
        "scope",
        "audit",
        "dispatched",
        "evidence",
        "observed_outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "audit": {
          "title": "ShadowAudit",
          "description": "The immutable record of one tool call: what was sent, what drifted, what changed, and the proof the write was correct. Matches agindow-runtime-contract.md \u00a73.3. No internal envelope \u2014 this shape is public and read by customers and agents.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "ts",
            "tool",
            "operation",
            "mode",
            "drift",
            "decision",
            "patch",
            "proof"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "ts": {
              "type": "string",
              "format": "date-time"
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "enum": [
                "read",
                "write",
                "unknown"
              ]
            },
            "mode": {
              "enum": [
                "observe"
              ]
            },
            "drift": {
              "$ref": "#/$defs/audit_drift"
            },
            "decision": {
              "enum": [
                "ok",
                "degraded",
                "bypassed"
              ]
            },
            "patch": {
              "anyOf": [
                {
                  "$ref": "#/$defs/audit_patch"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Required, possibly null. Null means nothing was changed \u2014 including the semantic-drift case that must fail closed."
            },
            "proof": {
              "$ref": "#/$defs/audit_proof"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hypothesis": {
              "type": "string",
              "minLength": 1,
              "description": "Engine's semantic reading before investigation (agindow-runtime-contract.md \u00a74a)."
            },
            "detail": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "metadata": {
              "type": "object",
              "additionalProperties": true,
              "description": "Free-form context (workflow, tenant, request id). Never credentials."
            }
          }
        },
        "dispatched": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phase"
          }
        },
        "observed_outcome": {
          "enum": [
            "succeeded",
            "upstream_error",
            "not_dispatched"
          ]
        }
      },
      "title": "ShadowCase",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "TI-28 strict halt evidence; runtime contract section 10.38. Bounded semantic validation applies at both boundaries."
    },
    "resolution": {
      "anyOf": [
        {
          "type": "object",
          "title": "ShadowResolution",
          "additionalProperties": false,
          "required": [
            "revision",
            "decision",
            "actor",
            "ts",
            "note"
          ],
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "decision": {
              "enum": [
                "accept_repair",
                "accept_original",
                "reject",
                "defer"
              ]
            },
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "ts": {
              "type": "string",
              "format": "date-time"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "audit_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Change taxonomy (field_renamed, type_changed, unit_changed, ...). Deliberately open: the vocabulary grows with the detectors."
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "audit_drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "side"
      ],
      "properties": {
        "class": {
          "enum": [
            "shape",
            "semantic",
            "unknown"
          ]
        },
        "side": {
          "enum": [
            "request",
            "response",
            "both"
          ]
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/audit_change"
          }
        },
        "first_seen": {
          "type": "string",
          "format": "date-time"
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "audit_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "byte_identical"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "byte_identical": {
          "type": "boolean",
          "description": "True only when the outgoing payload is the caller's bytes; false when repair built a new object (agindow-runtime-contract.md \u00a73.1)."
        },
        "fields_changed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selective": {
          "type": "boolean"
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "audit_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "verified_against",
        "write_integrity"
      ],
      "properties": {
        "contract_version": {
          "type": "string",
          "minLength": 1
        },
        "verified_against": {
          "enum": [
            "registry",
            "pin",
            "cache"
          ]
        },
        "write_integrity": {
          "type": "boolean"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "connection",
        "vendor",
        "operation",
        "contract_version",
        "repair_id"
      ],
      "properties": {
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "connection": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": "string",
          "minLength": 1
        },
        "repair_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "title": "ShadowReviewScope"
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "to",
        "kind",
        "class",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "enum": [
            "shape",
            "semantic",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "title": "ShadowReviewChange"
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding",
        "kind",
        "to",
        "replacement_hex",
        "detector",
        "applicability",
        "confidence",
        "assessment"
      ],
      "properties": {
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "rename",
            "replace"
          ]
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        },
        "replacement_hex": {
          "type": [
            "string",
            "null"
          ]
        },
        "detector": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        }
      },
      "title": "ShadowReviewProposal"
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "decision",
        "reason",
        "confidence",
        "verification",
        "changes",
        "proposals"
      ],
      "properties": {
        "side": {
          "enum": [
            "request",
            "response"
          ]
        },
        "decision": {
          "enum": [
            "pass",
            "repaired",
            "degraded",
            "halt"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposal"
          }
        }
      },
      "title": "ShadowReviewPhase"
    }
  }
}
