{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceRepairEvidence",
  "description": "TII-150 off-path, tenant-scoped reviewed migration references. No raw traffic, source text, narrative, execution or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "scope",
    "finding",
    "created_at",
    "expires_at",
    "facts",
    "attachments",
    "digest"
  ],
  "properties": {
    "contract": {
      "enum": [
        "source_repair_evidence"
      ]
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "investigation_id",
        "fingerprint",
        "observed_at",
        "expires_at",
        "field"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "investigation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "field": {
          "type": "string",
          "minLength": 2,
          "maxLength": 129,
          "pattern": "^/[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reference",
          "digest",
          "consent"
        ],
        "properties": {
          "kind": {
            "enum": [
              "source",
              "sanitized_fixture"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "consent": {
            "$ref": "#/$defs/consent"
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "connection",
        "operation",
        "side",
        "contract_revision",
        "evidence_revision"
      ],
      "properties": {
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "connection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "side": {
          "enum": [
            "request",
            "response"
          ]
        },
        "contract_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "evidence_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "kind",
        "from",
        "to",
        "provenance",
        "reviewed_by",
        "reviewed_at",
        "expires_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "kind": {
          "enum": [
            "reviewed_top_level_rename"
          ]
        },
        "from": {
          "type": "string",
          "minLength": 2,
          "maxLength": 129,
          "pattern": "^/[A-Za-z_][A-Za-z0-9_]*$"
        },
        "to": {
          "type": "string",
          "minLength": 2,
          "maxLength": 129,
          "pattern": "^/[A-Za-z_][A-Za-z0-9_]*$"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reference",
            "revision",
            "digest"
          ],
          "properties": {
            "kind": {
              "enum": [
                "vendor_declaration",
                "reviewed_contract"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actor",
        "scope",
        "kind",
        "evidence_digest",
        "granted_at",
        "expires_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "kind": {
          "enum": [
            "source",
            "sanitized_fixture"
          ]
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "granted_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
