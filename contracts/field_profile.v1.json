{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agindow.com/contracts/field_profile.v1.json",
  "title": "FieldProfile",
  "description": "TI-18 bounded segmented sufficient statistics; see runtime contract \u00a710.22.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "scope",
    "window_id",
    "start",
    "end",
    "types",
    "values",
    "hll",
    "numeric",
    "excluded_numbers",
    "charset"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "enum": [
        "field_profile"
      ]
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "vendor",
        "operation",
        "tenant_segment",
        "volume_cohort",
        "side",
        "field"
      ],
      "properties": {
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tenant_segment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "volume_cohort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "side": {
          "type": "string",
          "enum": [
            "request",
            "response"
          ]
        },
        "field": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^(?:/(?:[^~]|~[01])*)*$"
        }
      }
    },
    "window_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "start": {
      "type": "string",
      "format": "date-time"
    },
    "end": {
      "type": "string",
      "format": "date-time"
    },
    "types": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "values": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "hll": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 59
      }
    },
    "numeric": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "excluded_numbers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "charset": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  }
}
